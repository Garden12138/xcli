+@pytest.mark.parametrize("status", [302, 401, 429, 500])
+def test_no_redirect_retry_or_upstream_error_body_disclosure(bridge, status):
+    _, endpoint, state, _ = bridge
+    state.update(status=status, body={"error": TOKEN})
+    with pytest.raises(ProviderRunError) as error:
+        request(endpoint)
+    assert len(state["calls"]) == 1
+    assert TOKEN not in str(error.value)
