+"""Explicit, certificate-bound host bridge; never used by public HTTPS providers."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import ipaddress
+import json
+import os
+from pathlib import Path
+import re
+import ssl
+import stat
+from urllib.parse import urlsplit
+
+from cryptography import x509
+from cryptography.hazmat.primitives import serialization
+import httpx
+
+from app.providers.contracts import ProviderRunError
+
+INSTANCE_HEADER = "X-Xcli-Bridge-Instance"
+MAX_REQUEST = 4 * 1024 * 1024
+INSTANCE_PATTERN = r"[A-Za-z0-9][A-Za-z0-9_.-]{7,79}"
+
+
+def bridge_endpoint(value: str) -> str:
+    try:
+        url = urlsplit(value)
+        host = url.hostname or ""
+        if host != "host.docker.internal":
+            address = ipaddress.ip_address(host)
+            if not address.is_loopback:
+                raise ValueError()
+            host = f"[{address}]" if address.version == 6 else str(address)
+        if (url.scheme != "https" or not url.port or url.username is not None
+                or url.password is not None or url.query or url.fragment
+                or url.path.rstrip("/") != "/v1" or "%" in value or "\\" in value
+                or any(ord(c) <= 32 or ord(c) == 127 for c in value)):
+            raise ValueError()
+        return f"https://{host}:{url.port}/v1"
+    except ValueError:
+        raise ValueError("xcli bridge requires registered HTTPS host, explicit port and /v1") from None
+
+
+def registration() -> dict[str, str]:
+    endpoint = bridge_endpoint(os.environ.get("CONTRIBOS_XCLI_BRIDGE_ENDPOINT", ""))
+    instance = os.environ.get("CONTRIBOS_XCLI_BRIDGE_INSTANCE", "")
+    if not re.fullmatch(INSTANCE_PATTERN, instance):
+        raise ValueError("xcli bridge instance is not registered")
+    fingerprint = os.environ.get("CONTRIBOS_XCLI_BRIDGE_SERVER_SHA256", "")
+    if not re.fullmatch(r"[a-f0-9]{64}", fingerprint):
+        raise ValueError("xcli bridge server fingerprint is not registered")
+    return {"endpoint": endpoint, "instance_id": instance, "server_sha256": fingerprint}
+
+
+def registered_bridge(value: str, instance: str | None, fingerprint: str | None) -> str:
+    registered = registration()
+    endpoint = bridge_endpoint(value)
+    if (endpoint != registered["endpoint"] or instance != registered["instance_id"]
+            or fingerprint != registered["server_sha256"]):
+        raise ValueError("xcli bridge registration changed; create a new connection version")
+    return endpoint
+
+
+def private_file(path: Path) -> bytes:
+    """Only operator-owned regular files in an owner-only directory (Unix)."""
+    if os.name != "posix" or path.is_symlink():
+        raise ValueError("xcli bridge requires private Unix files")
+    parent = path.parent.resolve()
+    directory = parent.stat()
+    if directory.st_uid != os.getuid() or stat.S_IMODE(directory.st_mode) & 0o077:
+        raise ValueError("xcli bridge directory must be owner-only")
+    fd = os.open(parent / path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(fd)
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                or stat.S_IMODE(info.st_mode) & 0o077 or info.st_size > 65536):
+            raise ValueError("xcli bridge file must be private, regular and bounded")
+        with os.fdopen(fd, "rb", closefd=False) as stream:
+            data = stream.read(65537)
+        if len(data) > 65536:
+            raise ValueError("xcli bridge file exceeds limit")
+        return data
+    finally:
+        os.close(fd)
+
+
+def read_config(path: Path, expected: set[str]) -> dict:
+    value = json.loads(private_file(path))
+    if not isinstance(value, dict) or set(value) != expected or value.get("version") != 1:
+        raise ValueError("xcli bridge configuration schema is invalid")
+    if not isinstance(value.get("instance_id"), str) or not re.fullmatch(INSTANCE_PATTERN, value["instance_id"]):
+        raise ValueError("xcli bridge instance is invalid")
+    return value
+
+
+def certificate_path(config: Path, filename: str) -> Path:
+    if not isinstance(filename, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,79}", filename):
+        raise ValueError("xcli bridge requires a simple relative certificate filename")
+    path = config.parent / filename
+    private_file(path)
+    return path
+
+
+def certificate_fingerprint(data: bytes) -> str:
+    if data.count(b"-----BEGIN CERTIFICATE-----") != 1:
+        raise ValueError("xcli bridge requires one pinned leaf certificate")
+    certificate = x509.load_pem_x509_certificate(data)
+    if certificate.extensions.get_extension_for_class(x509.BasicConstraints).value.ca:
+        raise ValueError("xcli bridge server trust must pin a leaf, not a CA")
+    return hashlib.sha256(certificate.public_bytes(serialization.Encoding.DER)).hexdigest()
+
+
+def client_context(endpoint: str, instance: str, expected_fingerprint: str) -> ssl.SSLContext:
+    path = Path(os.environ.get("CONTRIBOS_XCLI_BRIDGE_CONFIG", ""))
+    config = read_config(path, {"version", "endpoint", "instance_id", "server_sha256",
+                                "server_certificate", "client_certificate", "client_key"})
+    if config["endpoint"] != endpoint or config["instance_id"] != instance:
+        raise ValueError("xcli bridge private configuration differs from registration")
+    server = certificate_path(path, config["server_certificate"])
+    fingerprint = certificate_fingerprint(private_file(server))
+    if config["server_sha256"] != fingerprint or fingerprint != expected_fingerprint:
+        raise ValueError("xcli bridge server fingerprint mismatch")
+    client = certificate_path(path, config["client_certificate"])
+    key = certificate_path(path, config["client_key"])
+    # Supplying cafile creates an exclusive trust store; system/public CAs are not loaded.
+    context = ssl.create_default_context(cafile=str(server))
+    context.minimum_version = ssl.TLSVersion.TLSv1_2
+    context.load_cert_chain(str(client), str(key))
+    return context
+
+
+class XcliBridgeClient:
+    """No environment proxy, redirect or retry; exact server leaf and frozen instance."""
+
+    def __init__(self, instance: str, fingerprint: str):
+        self.instance, self.fingerprint = instance, fingerprint
+
+    async def request(self, base_url: str, suffix: str, *, credential: str,
+                      payload: dict | None = None, timeout: int = 180) -> dict:
+        try:
+            endpoint = registered_bridge(base_url, self.instance, self.fingerprint)
+            context = client_context(endpoint, self.instance, self.fingerprint)
+        except (OSError, ValueError, TypeError, x509.ExtensionNotFound):
+            raise ProviderRunError("xcli_bridge_registration_required", "xcli 桥接登记或私有证书无效", retryable=False) from None
+        if (suffix not in {"/models", "/chat/completions"} or not credential
+                or len(credential) > 8192 or any(ord(c) < 33 or ord(c) > 126 for c in credential)
+                or (suffix == "/models") != (payload is None)):
+            raise ProviderRunError("xcli_request_invalid", "xcli 桥接请求无效", retryable=False)
+        try:
+            encoded = json.dumps(payload, allow_nan=False).encode() if payload is not None else None
+            if encoded is not None and len(encoded) > MAX_REQUEST:
+                raise ProviderRunError("xcli_request_too_large", "xcli 请求超过大小限制", retryable=False)
+            transport = httpx.AsyncHTTPTransport(verify=context, retries=0)
+            async with (asyncio.timeout(max(1, min(timeout, 180))),
+                        httpx.AsyncClient(transport=transport, trust_env=False, follow_redirects=False,
+                                          timeout=max(1, min(timeout, 180))) as client):
+                async with client.stream("POST" if encoded is not None else "GET", endpoint + suffix,
+                        headers={"Authorization": f"Bearer {credential}", "Content-Type": "application/json",
+                                 INSTANCE_HEADER: self.instance}, content=encoded) as response:
+                    if response.headers.get(INSTANCE_HEADER) != self.instance:
+                        raise ValueError()
+                    if not 200 <= response.status_code < 300:
+                        raise ProviderRunError("xcli_http_failed", f"xcli 桥接失败（HTTP {response.status_code}）", retryable=False)
+                    content = bytearray()
+                    limit = (4 if suffix == "/models" else 32) * 1024 * 1024
+                    async for chunk in response.aiter_bytes():
+                        content.extend(chunk)
+                        if len(content) > limit:
+                            raise ValueError()
+                    result = json.loads(content)
+                    if not isinstance(result, dict):
+                        raise ValueError()
+                    return result
+        except (httpx.HTTPError, OSError, ValueError, TypeError, UnicodeError):
+            raise ProviderRunError("xcli_transport_failed", "xcli 桥接不可达或响应无效；请求未自动重试", retryable=False) from None
