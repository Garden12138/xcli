+"""Synthetic certificates and loopback services; never touches operator credentials."""
+from contextlib import contextmanager
+from datetime import datetime, timedelta, timezone
+import hashlib
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import ipaddress
+import json
+from pathlib import Path
+import threading
+import time
+
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.x509.oid import ExtendedKeyUsageOID, NameOID
+
+from app.providers.xcli_bridge import certificate_fingerprint
+
+ALIAS = "xcli/text-default"
+INSTANCE = "synthetic-bridge-instance-01"
+TOKEN = "synthetic-application-token-canary"
+
+
+def private_write(path, value):
+    path.write_bytes(value if isinstance(value, bytes) else json.dumps(value).encode())
+    path.chmod(0o600)
+
+
+def certificate(name, *, issuer=None, ca=False, expired=False, server=False):
+    key = ec.generate_private_key(ec.SECP256R1())
+    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, name)])
+    now = datetime.now(timezone.utc)
+    issuer_cert, issuer_key = issuer if issuer else (None, key)
+    cert = (x509.CertificateBuilder().subject_name(subject)
+        .issuer_name(issuer_cert.subject if issuer_cert else subject).public_key(key.public_key())
+        .serial_number(x509.random_serial_number()).not_valid_before(now-timedelta(days=2))
+        .not_valid_after(now-timedelta(days=1) if expired else now+timedelta(days=2))
+        .add_extension(x509.BasicConstraints(ca=ca, path_length=0 if ca else None), critical=True)
+        .add_extension(x509.SubjectKeyIdentifier.from_public_key(key.public_key()), critical=False)
+        .add_extension(x509.AuthorityKeyIdentifier.from_issuer_public_key(issuer_key.public_key()), critical=False)
+        .add_extension(x509.KeyUsage(digital_signature=True, content_commitment=False,
+            key_encipherment=not ca, data_encipherment=False, key_agreement=False,
+            key_cert_sign=ca, crl_sign=ca, encipher_only=False, decipher_only=False), critical=True))
+    if not ca:
+        cert = cert.add_extension(x509.ExtendedKeyUsage([ExtendedKeyUsageOID.SERVER_AUTH if server
+                                                        else ExtendedKeyUsageOID.CLIENT_AUTH]), critical=False)
+    if server:
+        cert = cert.add_extension(x509.SubjectAlternativeName([
+            x509.IPAddress(ipaddress.ip_address("127.0.0.1")), x509.DNSName("host.docker.internal")]), critical=False)
+    return cert.sign(issuer_key, hashes.SHA256()), key
+
+
+def write_pair(root, name, pair):
+    cert, key = pair
+    private_write(root/f"{name}.pem", cert.public_bytes(serialization.Encoding.PEM))
+    private_write(root/f"{name}.key", key.private_bytes(serialization.Encoding.PEM,
+                  serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))
+    return hashlib.sha256(cert.public_bytes(serialization.Encoding.DER)).hexdigest()
+
+
+def credentials(root: Path):
+    root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    root.chmod(0o700)
+    ca = certificate("synthetic-client-ca", ca=True)
+    write_pair(root, "client-ca", ca)
+    client = certificate("synthetic-client", issuer=ca)
+    client_fingerprint = write_pair(root, "client", client)
+    write_pair(root, "expired-client", certificate("synthetic-expired-client", issuer=ca, expired=True))
+    write_pair(root, "unlisted-client", certificate("synthetic-unlisted", issuer=ca))
+    write_pair(root, "alien-client", certificate("synthetic-alien"))
+    server = certificate("synthetic-server", server=True)
+    write_pair(root, "server", server)
+    write_pair(root, "wrong-server", certificate("synthetic-other-server", server=True))
+    write_pair(root, "expired-server", certificate("synthetic-expired-server", server=True, expired=True))
+    return client_fingerprint
+
+
+def catalog():
+    return {"object": "list", "data": [{"id": ALIAS, "xcli": {
+        "capabilities": ["text.generate", "tool_calls", "json_schema"], "validated": True,
+        "inference_location": "remote"}}, {"id": "not-allowed"}]}
+
+
+@contextmanager
+def upstream_server():
+    state = {"calls": [], "status": 200, "body": None}
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+        def do_GET(self):
+            self.respond(None)
+        def do_POST(self):
+            self.respond(json.loads(self.rfile.read(int(self.headers["Content-Length"]))))
+        def respond(self, body):
+            state["calls"].append((self.path, self.headers.get("Authorization"), body))
+            value = state["body"] or (catalog() if body is None else {"choices": [{"message": {"content": "synthetic-ok"}}]})
+            encoded = value if isinstance(value, bytes) else json.dumps(value).encode()
+            self.send_response(state["status"])
+            self.send_header("Content-Length", str(len(encoded)))
+            self.end_headers()
+            try:
+                if state.get("trickle"):
+                    for byte in encoded:
+                        self.wfile.write(bytes([byte]))
+                        self.wfile.flush()
+                        time.sleep(state["trickle"])
+                else:
+                    self.wfile.write(encoded)
+            except (BrokenPipeError, ConnectionResetError):
+                pass
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}/v1", state
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(2)
+
+
+def relay_config(root, upstream, fingerprint):
+    return {"version": 1, "instance_id": INSTANCE, "upstream_base_url": upstream,
+        "listen_host": "127.0.0.1", "listen_port": 0, "server_certificate": "server.pem",
+        "server_key": "server.key", "client_ca": "client-ca.pem",
+        "allowed_client_fingerprints": [fingerprint], "allowed_models": [ALIAS],
+        "max_concurrent": 3, "max_requests_per_minute": 1000, "timeout_seconds": 5}
+
+
+@contextmanager
+def running_relay(root, config):
+    from app.providers.xcli_bridge_relay import RelayServer
+    private_write(root/"relay.json", config)
+    server = RelayServer(root/"relay.json")
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    endpoint = f"https://127.0.0.1:{server.server_port}/v1"
+    try:
+        yield server, endpoint
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(2)
+
+
+def configure_client(root, endpoint, monkeypatch, *, server="server", client="client"):
+    value = {"version": 1, "endpoint": endpoint, "instance_id": INSTANCE,
+        "server_sha256": certificate_fingerprint((root/f"{server}.pem").read_bytes()),
+        "server_certificate": f"{server}.pem", "client_certificate": f"{client}.pem",
+        "client_key": f"{client}.key"}
+    private_write(root/"client.json", value)
+    monkeypatch.setenv("CONTRIBOS_XCLI_BRIDGE_ENDPOINT", endpoint)
+    monkeypatch.setenv("CONTRIBOS_XCLI_BRIDGE_INSTANCE", INSTANCE)
+    monkeypatch.setenv("CONTRIBOS_XCLI_BRIDGE_CONFIG", str(root/"client.json"))
+    monkeypatch.setenv("CONTRIBOS_XCLI_BRIDGE_SERVER_SHA256", value["server_sha256"])
+    return value
