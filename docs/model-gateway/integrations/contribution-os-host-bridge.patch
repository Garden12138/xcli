+
+def test_private_permissions_symlinks_and_fingerprints_fail_closed(bridge):
+    root, endpoint, state, _ = bridge
+    key = root/"client.key"
+    key.chmod(0o644)
+    with pytest.raises(ProviderRunError):
+        request(endpoint)
+    key.chmod(0o600)
+    (root/"client-alias.key").symlink_to(key)
+    config = json.loads((root/"client.json").read_text())
+    config["client_key"] = "client-alias.key"
+    private_write(root/"client.json", config)
+    with pytest.raises(ProviderRunError):
+        request(endpoint)
