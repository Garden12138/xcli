+from app.providers.xcli_bridge import (INSTANCE_HEADER, XcliBridgeClient, bridge_endpoint,
+    client_context, registration, registered_bridge)
+from app.providers.xcli_bridge_relay import RelayServer
+from app.provenance import content_hash
+from tests.xcli_bridge_fixtures import (ALIAS, INSTANCE, TOKEN, configure_client, credentials,
+    private_write, relay_config, running_relay, upstream_server)
+
+
+@pytest.fixture
+def bridge(tmp_path, monkeypatch):
+    fingerprint = credentials(tmp_path)
+    with upstream_server() as (upstream, state):
+        config = relay_config(tmp_path, upstream, fingerprint)
+        with running_relay(tmp_path, config) as (server, endpoint):
+            configure_client(tmp_path, endpoint, monkeypatch)
+            yield tmp_path, endpoint, state, server
+
+
+def request(endpoint, payload=None, *, instance=INSTANCE, suffix=None):
+    return asyncio.run(XcliBridgeClient(instance, os.environ["CONTRIBOS_XCLI_BRIDGE_SERVER_SHA256"]).request(endpoint,
+        suffix or ("/chat/completions" if payload is not None else "/models"),
+        credential=TOKEN, payload=payload, timeout=5))
+
+
+def test_real_mutual_tls_and_frozen_model_capabilities(bridge):
+    root, endpoint, state, server = bridge
+    connection = ConnectionInput(name="synthetic", provider="xcli_bridge", base_url=endpoint,
+                                 credential_ref="cred-"+"1"*32)
+    assert connection.bridge_instance == INSTANCE
+    profile = {"model": ALIAS, "max_tokens": 32, "timeout_seconds": 5, "connection": connection.model_dump()}
+    original = content_hash(profile)
+    class Store:
+        def read(self, reference):
+            return TOKEN
+    result = asyncio.run(ProfileUpstream(profile, Store()).create_response({
+        "model": ALIAS, "messages": [{"role": "user", "content": "synthetic input"}],
+        "response_format": {"type": "json_schema", "json_schema": {"name": "test", "schema": {"type": "object"}}},
+        "max_tokens": 100}))
+    assert result["choices"][0]["message"]["content"] == "synthetic-ok"
+    assert len(state["calls"]) == 2
+    assert state["calls"][1][1] == "Bearer "+TOKEN
+    assert state["calls"][1][2]["max_tokens"] == 32
+    assert original == content_hash(profile)
+    assert [m["id"] for m in request(endpoint)["data"]] == [ALIAS]
+    assert configured_xcli_bridge() == {"endpoint": endpoint, "instance_id": INSTANCE,
+        "server_sha256": os.environ["CONTRIBOS_XCLI_BRIDGE_SERVER_SHA256"]}
+    assert "client.key" not in json.dumps(configured_xcli_bridge())
+
+
+@pytest.mark.parametrize("client", ["alien-client", "unlisted-client"])
+def test_untrusted_and_same_ca_unregistered_clients_never_forward(bridge, monkeypatch, client):
+    root, endpoint, state, _ = bridge
+    configure_client(root, endpoint, monkeypatch, client=client)
+    with pytest.raises(ProviderRunError) as error:
+        request(endpoint)
+    assert error.value.code == "xcli_transport_failed"
+    assert not state["calls"]
+
+
+def test_missing_client_certificate_never_forwards(bridge):
+    root, endpoint, state, _ = bridge
+    context = ssl.create_default_context(cafile=str(root/"server.pem"))
+    with httpx.Client(verify=context, trust_env=False, timeout=2) as client:
+        with pytest.raises(httpx.TransportError):
+            client.get(endpoint+"/models", headers={INSTANCE_HEADER: INSTANCE, "Authorization": "Bearer "+TOKEN})
+    assert not state["calls"]
