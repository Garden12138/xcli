+"""Opt-in host-only mTLS relay to one fixed loopback xcli installation."""
+from __future__ import annotations
+
+from collections import deque
+import hashlib
+import http.client
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import ipaddress
+import json
+from pathlib import Path
+import re
+import socket
+import ssl
+import threading
+import time
+from urllib.parse import urlsplit
+
+from app.providers.xcli_bridge import (INSTANCE_HEADER, MAX_REQUEST, certificate_path,
+    certificate_fingerprint, private_file, read_config)
+from app.providers.xcli_local import local_endpoint, native_runtime
+
+FIELDS = {"version", "instance_id", "upstream_base_url", "listen_host", "listen_port",
+          "server_certificate", "server_key", "client_ca", "allowed_client_fingerprints",
+          "allowed_models", "max_concurrent", "max_requests_per_minute", "timeout_seconds"}
+
+
+class RelayServer(ThreadingHTTPServer):
+    daemon_threads = True
+    allow_reuse_address = False
+
+    def __init__(self, config_path: Path):
+        if not native_runtime():
+            raise ValueError("xcli relay must run natively on the host")
+        config = read_config(config_path, FIELDS)
+        self.config = config
+        address = ipaddress.ip_address(config["listen_host"])
+        if not address.is_loopback:
+            raise ValueError("xcli relay must listen on a literal loopback IP")
+        for field, low, high in [("listen_port", 0, 65535), ("max_concurrent", 1, 8),
+                                  ("max_requests_per_minute", 1, 60000), ("timeout_seconds", 1, 180)]:
+            if type(config[field]) is not int or not low <= config[field] <= high:
+                raise ValueError("xcli relay bounds are invalid")
+        for field, pattern, maximum in [("allowed_client_fingerprints", r"[a-f0-9]{64}", 8),
+                                         ("allowed_models", r"[A-Za-z0-9_.:@/-]{1,120}", 64)]:
+            values = config[field]
+            if (not isinstance(values, list) or not 1 <= len(values) <= maximum
+                    or any(not isinstance(v, str) or not re.fullmatch(pattern, v) for v in values)
+                    or len(set(values)) != len(values)):
+                raise ValueError("xcli relay allowlist is invalid")
+        self.upstream = urlsplit(local_endpoint(config["upstream_base_url"]))
+        server_cert = certificate_path(config_path, config["server_certificate"])
+        self.fingerprint = certificate_fingerprint(private_file(server_cert))
+        server_key = certificate_path(config_path, config["server_key"])
+        client_ca = certificate_path(config_path, config["client_ca"])
+        self.context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        self.context.minimum_version = ssl.TLSVersion.TLSv1_2
+        self.context.load_cert_chain(str(server_cert), str(server_key))
+        self.context.load_verify_locations(cafile=str(client_ca))
+        self.context.verify_mode = ssl.CERT_REQUIRED
+        self.slots = threading.BoundedSemaphore(config["max_concurrent"])
+        self.rate_lock = threading.Lock()
+        self.timestamps: deque[float] = deque()
+        if address.version == 6:
+            self.address_family = socket.AF_INET6
+        super().__init__((str(address), config["listen_port"]), RelayHandler)
+
+    def get_request(self):
+        connection, address = super().get_request()
+        connection.settimeout(5)
+        try:
+            connection = self.context.wrap_socket(connection, server_side=True)
+            fingerprint = hashlib.sha256(connection.getpeercert(binary_form=True)).hexdigest()
+            if fingerprint not in self.config["allowed_client_fingerprints"]:
+                raise ssl.SSLError("unregistered client certificate")
+            connection.settimeout(self.config["timeout_seconds"])
+            return connection, address
+        except Exception:
+            connection.close()
+            raise
+
+    def process_request(self, request, client_address):
+        if not self.slots.acquire(blocking=False):
+            self.shutdown_request(request)
+            return
+        try:
+            super().process_request(request, client_address)
+        except Exception:
+            self.slots.release()
+            raise
+
+    def process_request_thread(self, request, client_address):
+        try:
+            super().process_request_thread(request, client_address)
+        finally:
+            self.slots.release()
+
+    def handle_error(self, request, client_address):
+        pass  # Never print request bodies, auth headers or private configuration.
+
+    def consume_request(self) -> bool:
+        with self.rate_lock:
+            now = time.monotonic()
+            while self.timestamps and self.timestamps[0] <= now - 60:
+                self.timestamps.popleft()
+            if len(self.timestamps) >= self.config["max_requests_per_minute"]:
+                return False
+            self.timestamps.append(now)
+            return True
+
+
+class RelayHandler(BaseHTTPRequestHandler):
+    server: RelayServer
+    protocol_version = "HTTP/1.0"
+
+    def setup(self):
+        super().setup()
+        self.upstream_socket = None
+        self.expired = threading.Event()
+        self.deadline = threading.Timer(self.server.config["timeout_seconds"], self.expire)
+        self.deadline.daemon = True
+        self.deadline.start()
+
+    def expire(self):
+        self.expired.set()
+        for connection in (self.connection, self.upstream_socket):
+            if connection is not None:
+                try:
+                    connection.shutdown(socket.SHUT_RDWR)
+                except OSError:
+                    pass
+
+    def finish(self):
+        self.deadline.cancel()
+        super().finish()
+
+    def log_message(self, format, *args):
+        pass
+
+    def respond(self, status: int, body: bytes = b'{"error":"xcli_bridge_request_failed"}'):
+        self.close_connection = True
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header(INSTANCE_HEADER, self.server.config["instance_id"])
+        self.send_header("Content-Length", str(len(body)))
+        self.send_header("Connection", "close")
+        self.end_headers()
+        self.wfile.write(body)
+
+    def send_error(self, code, message=None, explain=None):
+        self.respond(code)
+
+    def do_GET(self):
+        self.forward()
+
+    def do_POST(self):
+        self.forward()
+
+    def forward(self):
+        if not self.server.consume_request():
+            self.respond(429)
+            return
+        if (self.headers.get_all("Origin") or self.headers.get_all("Transfer-Encoding")
+                or self.headers.get_all("Expect") or len(self.headers.get_all(INSTANCE_HEADER, [])) != 1
+                or self.headers.get(INSTANCE_HEADER) != self.server.config["instance_id"]
+                or len(self.headers.get_all("Authorization", [])) != 1):
+            self.respond(403)
+            return
+        auth = self.headers["Authorization"]
+        if not re.fullmatch(r"Bearer [\x21-\x7e]{1,8192}", auth):
+            self.respond(403)
+            return
+        lengths = self.headers.get_all("Content-Length", [])
+        if len(lengths) > 1 or (lengths and not re.fullmatch(r"[0-9]{1,8}", lengths[0])):
+            self.respond(400)
+            return
+        length = int(lengths[0]) if lengths else 0
+        payload = None
+        if self.command == "GET" and self.path == "/v1/models" and length == 0:
+            pass
+        elif self.command == "POST" and self.path == "/v1/chat/completions":
+            if not 0 < length <= MAX_REQUEST:
+                self.respond(413)
+                return
+            if (len(self.headers.get_all("Content-Type", [])) != 1
+                    or self.headers.get_content_type() != "application/json"):
+                self.respond(415)
+                return
+            try:
+                payload = self.rfile.read(length)
+                value = json.loads(payload)
+                if (len(payload) != length or not isinstance(value, dict)
+                        or value.get("model") not in self.server.config["allowed_models"]
+                        or value.get("stream") not in (None, False)):
+                    raise ValueError()
+            except (ValueError, UnicodeError, TypeError):
+                self.respond(400)
+                return
+        else:
+            self.respond(404)
+            return
+        connection = http.client.HTTPConnection(self.server.upstream.hostname, self.server.upstream.port,
+                                                timeout=self.server.config["timeout_seconds"])
+        try:
+            connection.request(self.command, self.path, body=payload,
+                               headers={"Authorization": auth, "Content-Type": "application/json",
+                                        "Accept-Encoding": "identity"})
+            self.upstream_socket = connection.sock
+            if self.expired.is_set():
+                raise TimeoutError()
+            response = connection.getresponse()
+            if not 200 <= response.status < 300:
+                self.respond(502)  # Do not expose upstream errors, redirects or their bodies.
+                return
+            limit = (4 if self.command == "GET" else 32) * 1024 * 1024
+            body = response.read(limit + 1)
+            if len(body) > limit:
+                raise ValueError()
+            value = json.loads(body)
+            if not isinstance(value, dict):
+                raise ValueError()
+            if self.command == "GET":
+                if value.get("object") != "list" or not isinstance(value.get("data"), list):
+                    raise ValueError()
+                value["data"] = [model for model in value["data"] if isinstance(model, dict)
+                                 and model.get("id") in self.server.config["allowed_models"]]
+                body = json.dumps(value, allow_nan=False).encode()
+            self.respond(200, body)
+        except (OSError, http.client.HTTPException, ValueError, UnicodeError):
+            self.respond(502)
+        finally:
+            connection.close()
+
+
+def run_relay(config_path: Path) -> int:
+    with RelayServer(config_path) as server:
+        print(json.dumps({"instance_id": server.config["instance_id"], "host": server.server_address[0],
+                          "port": server.server_address[1], "server_sha256": server.fingerprint}), flush=True)
+        try:
+            server.serve_forever()
+        except KeyboardInterrupt:
+            pass
+    return 0
