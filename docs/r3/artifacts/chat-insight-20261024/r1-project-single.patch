@@ -0,0 +1,131 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import type { DateRange, RangePreset } from "../types";
+import { DateRangePicker } from "./DateRangePicker";
+
+const presets: Array<{ value: RangePreset; label: string }> = [
+  { value: "30d", label: "近 30 天" },
+  { value: "1y", label: "近 1 年" },
+  { value: "all", label: "全部" },
+  { value: "custom", label: "自定义" },
+];
+
+function expectSelectedPreset(preset: RangePreset) {
+  for (const { value, label } of presets) {
+    const button = screen.getByRole("button", { name: label });
+    expect(button).toHaveAttribute("aria-pressed", String(value === preset));
+    if (value === preset) {
+      expect(button).toHaveClass("active");
+    } else {
+      expect(button).not.toHaveClass("active");
+    }
+  }
+}
+
+describe("DateRangePicker", () => {
+  it.each(presets)("marks only $value as pressed and active", ({ value }) => {
+    render(<DateRangePicker preset={value} range={{}} onPresetChange={vi.fn()} onRangeChange={vi.fn()} />);
+
+    expectSelectedPreset(value);
+  });
+
+  it("updates selection and custom inputs when the preset prop changes", () => {
+    const onPresetChange = vi.fn();
+    const onRangeChange = vi.fn();
+    const props = { range: {}, onPresetChange, onRangeChange };
+    const { rerender } = render(<DateRangePicker {...props} preset="30d" />);
+
+    expectSelectedPreset("30d");
+    expect(screen.queryByLabelText("开始日期")).not.toBeInTheDocument();
+    expect(screen.queryByLabelText("结束日期")).not.toBeInTheDocument();
+
+    const updatedPresets: RangePreset[] = ["1y", "all", "custom", "30d"];
+    for (const preset of updatedPresets) {
+      rerender(<DateRangePicker {...props} preset={preset} />);
+
+      expectSelectedPreset(preset);
+      if (preset === "custom") {
+        expect(screen.getByLabelText("开始日期")).toBeVisible();
+        expect(screen.getByLabelText("结束日期")).toBeVisible();
+      } else {
+        expect(screen.queryByLabelText("开始日期")).not.toBeInTheDocument();
+        expect(screen.queryByLabelText("结束日期")).not.toBeInTheDocument();
+      }
+    }
+
+    expect(onPresetChange).not.toHaveBeenCalled();
+    expect(onRangeChange).not.toHaveBeenCalled();
+  });
+
+  it.each(presets)("reports $value on click and keeps selection controlled by props", ({ value, label }) => {
+    const onPresetChange = vi.fn();
+    const onRangeChange = vi.fn();
+    const selectedPreset: RangePreset = value === "30d" ? "1y" : "30d";
+    render(<DateRangePicker preset={selectedPreset} range={{}} onPresetChange={onPresetChange} onRangeChange={onRangeChange} />);
+
+    fireEvent.click(screen.getByRole("button", { name: label }));
+
+    expect(onPresetChange.mock.calls).toStrictEqual([[value]]);
+    expect(onRangeChange).not.toHaveBeenCalled();
+    expectSelectedPreset(selectedPreset);
+    expect(screen.queryByLabelText("开始日期")).not.toBeInTheDocument();
+    expect(screen.queryByLabelText("结束日期")).not.toBeInTheDocument();
+  });
+
+  it("updates date inputs from external range props without invoking callbacks", () => {
+    const onPresetChange = vi.fn();
+    const onRangeChange = vi.fn();
+    const props = { preset: "custom" as const, onPresetChange, onRangeChange };
+    const { rerender } = render(<DateRangePicker {...props} range={{ from: "2026-09-01", to: "2026-09-30" }} />);
+    const updatedRanges: DateRange[] = [
+      { from: "2026-10-02", to: "2026-10-20" },
+      { to: "2026-10-25" },
+      { from: "2026-10-05" },
+      {},
+    ];
+
+    for (const range of updatedRanges) {
+      rerender(<DateRangePicker {...props} range={range} />);
+
+      expect(screen.getByLabelText("开始日期")).toHaveValue(range.from ?? "");
+      expect(screen.getByLabelText("结束日期")).toHaveValue(range.to ?? "");
+      expectSelectedPreset("custom");
+    }
+
+    expect(onPresetChange).not.toHaveBeenCalled();
+    expect(onRangeChange).not.toHaveBeenCalled();
+  });
+
+  const dateChanges: Array<{ label: string; value: string; expectedRange: DateRange }> = [
+    { label: "开始日期", value: "2026-09-05", expectedRange: { from: "2026-09-05", to: "2026-09-30" } },
+    { label: "结束日期", value: "2026-09-25", expectedRange: { from: "2026-09-01", to: "2026-09-25" } },
+    { label: "开始日期", value: "", expectedRange: { from: undefined, to: "2026-09-30" } },
+    { label: "结束日期", value: "", expectedRange: { from: "2026-09-01", to: undefined } },
+  ];
+
+  it.each(dateChanges)("reports $label changed to '$value' while preserving the other endpoint", ({ label, value, expectedRange }) => {
+    const onPresetChange = vi.fn();
+    const onRangeChange = vi.fn();
+    const range: DateRange = { from: "2026-09-01", to: "2026-09-30" };
+    const props = { preset: "custom" as const, onPresetChange, onRangeChange };
+    const { rerender } = render(<DateRangePicker {...props} range={range} />);
+
+    expect(screen.getByLabelText("开始日期")).toHaveValue(range.from);
+    expect(screen.getByLabelText("结束日期")).toHaveValue(range.to);
+
+    fireEvent.change(screen.getByLabelText(label), { target: { value } });
+
+    expect(onRangeChange.mock.calls).toStrictEqual([[expectedRange]]);
+    expect(onPresetChange).not.toHaveBeenCalled();
+    expectSelectedPreset("custom");
+    expect(screen.getByLabelText("开始日期")).toHaveValue(range.from);
+    expect(screen.getByLabelText("结束日期")).toHaveValue(range.to);
+
+    rerender(<DateRangePicker {...props} range={expectedRange} />);
+
+    expect(screen.getByLabelText("开始日期")).toHaveValue(expectedRange.from ?? "");
+    expect(screen.getByLabelText("结束日期")).toHaveValue(expectedRange.to ?? "");
+    expect(onRangeChange.mock.calls).toStrictEqual([[expectedRange]]);
+    expect(onPresetChange).not.toHaveBeenCalled();
+  });
+});
